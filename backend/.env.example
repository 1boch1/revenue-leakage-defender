# Revenue Leakage Defender: Variabili d'ambiente
# Copia questo file come .env e inserisci la tua API key. Non committare mai il file .env su Git!

# Google Gemini (free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=la-tua-api-key-qui
GEMINI_MODEL=gemini-2.0-flash

# Opzionale: LangSmith Tracing per visualizzare l'esecuzione del grafo in tempo reale
# https://smith.langchain.com
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=la-tua-langsmith-key
# LANGCHAIN_PROJECT=revenue-leakage-defender
